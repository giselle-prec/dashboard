# Bloqueia todo acesso direto via navegador a esta pasta. Esses arquivos
# (config.ini com a senha do banco, connection.php, etc.) só devem ser
# carregados pelo PHP via require, nunca requisitados diretamente pela web.
# Não afeta nenhuma outra pasta do site.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
